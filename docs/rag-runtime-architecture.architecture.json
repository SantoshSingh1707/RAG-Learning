  "cards": [
    {
      "dot": "cyan",
      "title": "Runtime shape",
      "items": [
        "Model, index, retriever, and chat client are built once per process",
        "No authentication, authorization, rate limiting, or tenant isolation",
        "The index directory is gitignored and regenerable from the source files"
      ]
    },
    {
      "dot": "emerald",
      "title": "Read path",
      "items": [
        "The query is embedded with a query prefix and searched by cosine distance",
        "Candidates are over-fetched 4x, gated, deduplicated, then cut to top_k",
        "An empty index returns no context instead of calling the model"
      ]
    },
    {
      "dot": "rose",
      "title": "Untrusted content",
      "items": [
        "Uploads are size-limited, written to a temp dir, and filename-sanitized",
        "Retrieved text is a reference block; the prompt forbids obeying it",
        "With Mistral selected, retrieved text is sent to a third-party API"
      ]
    }
  ]
