# Chat provider: "ollama" runs fully locally, "mistral" uses the hosted API.
RAG_LLM_PROVIDER=ollama

# Local Ollama settings (used when RAG_LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# Keep the model resident so Streamlit reruns do not pay the ~40s cold start.
OLLAMA_KEEP_ALIVE=30m
# Lower these on a small GPU. 8192 tokens needs roughly 1.5 GB of KV cache
# alongside a 7B Q4 model.
# OLLAMA_NUM_CTX=8192
# OLLAMA_NUM_PREDICT=512
# RAG_MAX_CONTEXT_CHARS=24000

# Required only when RAG_LLM_PROVIDER=mistral
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-2506
# MISTRAL_TIMEOUT_SECONDS=45
# MISTRAL_MAX_RETRIES=2

# Optional for private or gated embedding models
HUGGINGFACEHUB_API_TOKEN=

# Optional overrides
# RAG_COLLECTION_NAME=rag_documents_v2
# EMBEDDING_MODEL=multi-qa-MiniLM-L6-cos-v1
# EMBEDDING_MODEL_REVISION=b207367332321f8e44f96e224ef15bc607f4dbf0
# RAG_MIN_SCORE=0.35
# RAG_TOP_K=5
# RAG_CHUNK_SIZE=1000
# RAG_CHUNK_OVERLAP=200
# RAG_EMBEDDING_BATCH_SIZE=128
# RAG_MAX_UPLOAD_BYTES=209715200
